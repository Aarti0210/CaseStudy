# ==========================================================
# Judicial Supreme Backend - Production Environment Template
# ==========================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: NEVER commit actual .env file to version control!

# ==========================================================
# Flask Application Configuration
# ==========================================================
FLASK_ENV=production
FLASK_APP=run:app
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
DEBUG=false
LOG_LEVEL=INFO

# ==========================================================
# Security Keys (GENERATE SECURE RANDOM VALUES!)
# ==========================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE-WITH-32-CHAR-RANDOM-SECRET-KEY
JWT_SECRET_KEY=REPLACE-WITH-32-CHAR-RANDOM-JWT-SECRET

# ==========================================================
# Database Configuration
# ==========================================================
# PostgreSQL (Production - Neon)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# SQLite (Development - Comment out for production)
# DATABASE_URL=sqlite:///judicial_dev.db

# Database Pool Settings (PostgreSQL only)
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=2
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=false

# ==========================================================
# Rate Limiting (Production)
# ==========================================================
# Redis (Upstash - Production)
RATELIMIT_STORAGE_URI=rediss://default:YOUR_PASSWORD@YOUR_HOST:6379

# Memory (Development - Comment out for production)
# RATELIMIT_STORAGE_URI=memory://

RATELIMIT_DEFAULT=200 per day;50 per hour

# ==========================================================
# Email Configuration
# ==========================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=no-reply@judicial.local

# ==========================================================
# JWT Configuration
# ==========================================================
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# ==========================================================
# OTP Configuration
# ==========================================================
OTP_TTL=300
OTP_RESEND_COOLDOWN=60
OTP_SEND_MAX_RETRIES=3

# ==========================================================
# OpenAI Configuration
# ==========================================================
OPENAI_API_KEY=sk-REPLACE-WITH-YOUR-OPENAI-API-KEY
AI_MODEL=gpt-4-turbo
AI_CACHE_TTL=300

# ==========================================================
# File Upload Configuration
# ==========================================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ==========================================================
# ML Model Configuration
# ==========================================================
LOW_DELAY_THRESHOLD=365
HIGH_DELAY_THRESHOLD=900

# ==========================================================
# Development Settings (Comment out for production)
# ==========================================================
# Set to "1" to auto-create tables on startup (DEVELOPMENT ONLY!)
# CREATE_ALL_ON_START=false

# ==========================================================
# Production Deployment Settings
# ==========================================================
# Render automatically sets PORT environment variable
PORT=5000

# ==========================================================
# Security Headers
# ==========================================================
# Enable additional security headers
SECURE_HEADERS=true

# ==========================================================
# Monitoring & Analytics
# ==========================================================
# Enable performance monitoring
ENABLE_METRICS=true

# ==========================================================
# API Rate Limiting
# ==========================================================
# Stricter rate limits for production
STRICT_RATE_LIMITING=true
