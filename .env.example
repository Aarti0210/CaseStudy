# Production Environment Configuration
# Copy this file to .env and fill in the values
# IMPORTANT: DO NOT commit actual .env to version control

# ==========================================
# Flask Configuration
# ==========================================
# NOTE: For local development (e.g. Android emulator) you can set FLASK_ENV=development
# and bind Flask to 0.0.0.0 so emulators can reach the host machine.
FLASK_ENV=production
FLASK_APP=run:app
# When using `flask run`, these ensure the server is reachable from other devices
# (e.g. Android emulator at 10.0.2.2:5000).
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
DEBUG=false
LOG_LEVEL=INFO

# ==========================================
# Security Keys (Generate secure random values!)
# ==========================================
# JWT_SECRET_KEY: Use 32+ character random string
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-jwt-secret-with-32-char-random-string
SECRET_KEY=replace-me-with-random-secret-key

# ==========================================
# Database Configuration
# ==========================================
# Database connection string (Render provides a PostgreSQL URL by default)
# Example: postgresql://username:password@host:5432/dbname
DATABASE_URL=postgresql://user:pass@localhost:5432/judicial_supreme

# ==========================================
# OpenAI API (Optional)
# ==========================================
OPENAI_API_KEY=

# ==========================================
# Gunicorn Configuration
# ==========================================
# Number of worker processes
GUNICORN_WORKERS=2

# ==========================================
# Uploads & Files
# ==========================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ==========================================
# JWT Configuration
# ==========================================
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# ==========================================
# OTP Configuration
# ==========================================
OTP_TTL=300
OTP_RESEND_COOLDOWN=60
OTP_SEND_MAX_RETRIES=3

# ==========================================
# Email Configuration (for OTP and notifications)
# ==========================================
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@judicial.local
